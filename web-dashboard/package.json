{
  "name": "fenghou-web-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "tsc -b --pretty false",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --d1 DB=fenghou-device-data",
    "pages:deploy": "wrangler pages deploy dist"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "recharts": "^3.0.0",
    "vite": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260530.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.18.0"
  }
}
